{
  "name": "dsh-gta6",
  "version": "0.1.2",
  "private": false,
  "description": "A neon Vice City theme for DeepSeek Harness, built on official Grand Theft Auto VI key art.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manyuemeiquqi/dsh-gta6.git"
  },
  "homepage": "https://github.com/manyuemeiquqi/dsh-gta6#readme",
  "bugs": {
    "url": "https://github.com/manyuemeiquqi/dsh-gta6/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "theme",
    "gta6",
    "vice-city",
    "pet"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.0 <0.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./assets/*": "./lib/assets/*",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "README.en.md",
    "NOTICE.md",
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/assets/*.jpg",
    "lib/assets/*.png",
    "lib/assets/*.webp",
    "lib/assets/NOTICE.txt",
    "src/client",
    "src/host/index.cjs",
    "src/shared",
    "scripts/build.mjs"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "npm run build && node --check index.js && node --check client.js"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "esbuild": "^0.28.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
